# Database Configuration
# The host 'mysql' must match the service name defined in your docker-compose.yml
DATABASE_URL="mysql://root:password@mysql:3306/playlists"

# Authentication (NextAuth)
# Set NEXTAUTH_URL to your public domain in production
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-secure-32-character-random-string"

# Application URLs & Environment
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="production"

# Supabase Integration (Reference: Worklog Task 14)
# Used for supplemental services or storage helpers
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# External APIs (Music Metadata & Promotion)
SPOTIFY_CLIENT_ID="your-spotify-client-id"
SPOTIFY_CLIENT_SECRET="your-spotify-client-secret"
YOUTUBE_API_KEY="your-youtube-api-key"

# Payment Gateway Credentials
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
PAYSTACK_SECRET_KEY="sk_test_..."
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-..."

# Email Configuration (Nodemailer)
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER="your-smtp-user"
EMAIL_SERVER_PASSWORD="your-smtp-password"
EMAIL_FROM="noreply@plugtoplaylist.com"

# Seed Admin Credentials (Reference: SEEDING.md)
ADMIN_DEFAULT_PASSWORD="AdminPassword123!"
SUPPORT_DEFAULT_PASSWORD="SupportPass123!"
CURRENCY="GBP"